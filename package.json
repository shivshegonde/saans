{
  "name": "saans-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=web",
    "test": "npm run test --workspace=server",
    "test:web": "npm run test --workspace=web",
    "test:coverage": "npm run test:coverage --workspace=server",
    "test:all": "npm run test && npm run test:web",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint \"{server,web,shared}/**/*.{ts,tsx}\"",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint \"{server,web,shared}/**/*.{ts,tsx}\" --fix",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=server && npm run typecheck --workspace=web",
    "check:size": "node server/scripts/check-router-sizes.js",
    "openapi": "npm run openapi --workspace=server",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run check:size && npm run test:coverage && npm run test:web && npm run build",
    "start": "node server/dist/src/server.js",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "playwright": "^1.65.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
